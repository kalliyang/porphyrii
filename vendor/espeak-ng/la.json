{
  "_meta": {
    "mappingVersion": "0.1.0",
    "language": "la",
    "source": "https://github.com/classical-cat-dh-lab/espeak-ng-wasm/releases/tag/v0.1.1",
    "license": "GPL-3.0-only",
    "basis": "eSpeak NG 1.52.0 phsource/ph_latin and the main phoneme table.",
    "conventions": "Input IPA must be NFC. Diphthongs carry U+032F COMBINING INVERTED BREVE BELOW on the off-glide (aɪ̯); otherwise consecutive vowel symbols are hiatus. Consonant gemination uses U+02D0 (tː), and long vowels use U+02D0 (aː). The ui of cui/huic is realized as ʊ+j because ph_latin has no uI diphthong. Aspirated stops pʰ/tʰ/kʰ map to stop+h sequences. Single r uses R and geminate rː uses R:. Short i/u/e/o use ɪ/ʊ/ɛ/ɔ."
  },
  "rules": [
    { "ipa": "aɪ̯", "mnemonic": "aI", "kind": "diphthong", "note": "ae" },
    { "ipa": "aʊ̯", "mnemonic": "aU", "kind": "diphthong", "note": "au" },
    { "ipa": "eɪ̯", "mnemonic": "eI", "kind": "diphthong", "note": "ei" },
    { "ipa": "eʊ̯", "mnemonic": "EU", "kind": "diphthong", "note": "eu" },
    { "ipa": "oɪ̯", "mnemonic": "OI", "kind": "diphthong", "note": "oe" },
    { "ipa": "kʷ", "mnemonic": "kw", "kind": "consonant", "note": "qu" },
    { "ipa": "ɡʷ", "mnemonic": "gw", "kind": "consonant", "note": "gu before vowel" },
    { "ipa": "pʰ", "mnemonic": "p h", "kind": "consonant", "note": "ph, Greek loanwords — aspirated stop (golden age)" },
    { "ipa": "tʰ", "mnemonic": "t h", "kind": "consonant", "note": "th, Greek loanwords — aspirated stop (golden age)" },
    { "ipa": "kʰ", "mnemonic": "k h", "kind": "consonant", "note": "ch, Greek loanwords — aspirated stop (golden age)" },

    { "ipa": "aː", "mnemonic": "a:", "kind": "vowel" },
    { "ipa": "eː", "mnemonic": "e:", "kind": "vowel" },
    { "ipa": "iː", "mnemonic": "i:", "kind": "vowel" },
    { "ipa": "oː", "mnemonic": "o:", "kind": "vowel" },
    { "ipa": "uː", "mnemonic": "u:", "kind": "vowel" },
    { "ipa": "yː", "mnemonic": "y:", "kind": "vowel", "note": "Greek loanwords" },

    { "ipa": "pː", "mnemonic": "p:", "kind": "consonant", "note": "geminate" },
    { "ipa": "tː", "mnemonic": "t:", "kind": "consonant", "note": "geminate" },
    { "ipa": "kː", "mnemonic": "k:", "kind": "consonant", "note": "geminate" },
    { "ipa": "bː", "mnemonic": "b:", "kind": "consonant", "note": "geminate" },
    { "ipa": "dː", "mnemonic": "d:", "kind": "consonant", "note": "geminate" },
    { "ipa": "ɡː", "mnemonic": "g:", "kind": "consonant", "note": "geminate" },
    { "ipa": "gː", "mnemonic": "g:", "kind": "consonant", "note": "geminate (ASCII g)" },
    { "ipa": "mː", "mnemonic": "m:", "kind": "consonant", "note": "geminate" },
    { "ipa": "nː", "mnemonic": "n:", "kind": "consonant", "note": "geminate" },
    { "ipa": "fː", "mnemonic": "f:", "kind": "consonant", "note": "geminate" },
    { "ipa": "sː", "mnemonic": "s:", "kind": "consonant", "note": "geminate" },
    { "ipa": "lː", "mnemonic": "l:", "kind": "consonant", "note": "geminate" },
    { "ipa": "rː", "mnemonic": "R:", "kind": "consonant", "note": "geminate — long trill" },

    { "ipa": "a", "mnemonic": "a", "kind": "vowel" },
    { "ipa": "e", "mnemonic": "E", "kind": "vowel" },
    { "ipa": "i", "mnemonic": "I", "kind": "vowel" },
    { "ipa": "o", "mnemonic": "O", "kind": "vowel" },
    { "ipa": "u", "mnemonic": "U", "kind": "vowel" },
    { "ipa": "y", "mnemonic": "y", "kind": "vowel", "note": "Greek loanwords" },
    { "ipa": "ɛ", "mnemonic": "E", "kind": "vowel", "note": "lax short e — canonical caller notation" },
    { "ipa": "ɔ", "mnemonic": "O", "kind": "vowel", "note": "lax short o — canonical caller notation" },
    { "ipa": "ɪ", "mnemonic": "I", "kind": "vowel", "note": "lax short i — canonical caller notation" },
    { "ipa": "ʊ", "mnemonic": "U", "kind": "vowel", "note": "lax short u — canonical caller notation" },

    { "ipa": "p", "mnemonic": "p", "kind": "consonant" },
    { "ipa": "b", "mnemonic": "b", "kind": "consonant" },
    { "ipa": "t", "mnemonic": "t", "kind": "consonant" },
    { "ipa": "d", "mnemonic": "d", "kind": "consonant" },
    { "ipa": "k", "mnemonic": "k", "kind": "consonant" },
    { "ipa": "ɡ", "mnemonic": "g", "kind": "consonant" },
    { "ipa": "g", "mnemonic": "g", "kind": "consonant", "note": "ASCII g alias" },
    { "ipa": "m", "mnemonic": "m", "kind": "consonant" },
    { "ipa": "n", "mnemonic": "n", "kind": "consonant" },
    { "ipa": "ŋ", "mnemonic": "N", "kind": "consonant", "note": "n before k/g" },
    { "ipa": "f", "mnemonic": "f", "kind": "consonant" },
    { "ipa": "s", "mnemonic": "s", "kind": "consonant" },
    { "ipa": "z", "mnemonic": "z", "kind": "consonant", "note": "Greek loanwords — [zd] realized as z+d sequence" },
    { "ipa": "h", "mnemonic": "h", "kind": "consonant" },
    { "ipa": "w", "mnemonic": "w", "kind": "consonant", "note": "consonantal u/v" },
    { "ipa": "j", "mnemonic": "j", "kind": "consonant", "note": "i consonans; intervocalic gemination written jj" },
    { "ipa": "l", "mnemonic": "l", "kind": "consonant" },
    { "ipa": "r", "mnemonic": "R", "kind": "consonant", "note": "trill — classical convention (Allen); espeak la default" }
  ]
}
